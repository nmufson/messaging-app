{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": false,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "sourceMap": true,
    "composite": true,
    "declaration": true
  },
  "include": ["./src/**/*"]
}
