{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declarationMap": true,
    "module": "commonjs",
    "target": "ES2019",
    "esModuleInterop": true,
    "strict": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "baseUrl": ".",
    "composite": true,
    "declaration": true
  },
  "include": ["./src/**/*"]
}
