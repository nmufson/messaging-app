{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "baseUrl": ".",

    "outDir": "dist",

    "composite": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],

  "references": [{ "path": "../../packages/common" }]
}
