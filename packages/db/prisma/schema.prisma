generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                          String            @id @default(cuid())
  email                       String            @unique
  hashedPassword              String
  role                        UserRole          @default(USER)
  createdAt                   DateTime          @default(now())
  
  profile                     Profile?
}

model Profile {
  id                          String            @id @default(cuid())
  firstName                   String 
  lastName                    String
  profilePictureUrl           String?

  friends                     Profile[]            @relation("UserFriends")
  friendOf                    Profile[]            @relation("UserFriends")
  sentFriendRequests          FriendRequest[]   @relation("SentRequests")
  receivedFriendRequests      FriendRequest[]   @relation("ReceivedRequests")
  messages                    Message[]         @relation("SentMessages")
  conversations               Conversation[]    @relation("ConversationParticipants")

  userId                      String            @unique
  user                        User              @relation(fields: [userId], references: [id])

  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime?
}

enum FriendRequestStatus {
  PENDING
  CANCELLED
  DECLINED
  ACCEPTED
}

model FriendRequest {
  id          String                @id @default(cuid())
  status      FriendRequestStatus   @default(PENDING)
  senderId    String
  sender      Profile               @relation("SentRequests", fields: [senderId], references: [id])
  receiverId  String
  receiver    Profile               @relation("ReceivedRequests", fields: [receiverId], references: [id])

  createdAt   DateTime              @default(now())
  updatedAt   DateTime?            
}

enum ConversationType {
  DIRECT
  GROUP
}

model Conversation {
  id              String @id    @default(cuid())
  creator         String
  type            ConversationType
  messages        Message[]
  participants    Profile[]     @relation("ConversationParticipants")

  createdAt       DateTime      @default(now())
  updatedAt       DateTime?
}

enum MessageType {
  TEXT
  IMAGE
}

model Message {
  id                String          @id @default(cuid())
  type              MessageType
  content           String?
  imageUrl          String?
  senderId          String
  sender            Profile         @relation("SentMessages", fields: [senderId], references: [id])
  conversationId    String
  conversation      Conversation    @relation(fields: [conversationId], references: [id])

  createdAt         DateTime        @default(now())
  updatedAt         DateTime?            
}

