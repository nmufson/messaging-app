generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id          String   @id
  sid         String   @unique
  data        String   @db.Text
  expiresAt   DateTime
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                          String            @id @default(uuid())
  email                       String            @unique
  hashedPassword              String
  role                        UserRole          @default(USER)
  createdAt                   DateTime          @default(now())
  
  profile                     Profile?
}

model Profile {
  id                          String            @id @default(uuid())
  firstName                   String 
  lastName                    String
  profilePictureUrl           String?

  friends                     Profile[]            @relation("UserFriends")
  friendOf                    Profile[]            @relation("UserFriends")
  sentFriendRequests          FriendRequest[]   @relation("SentRequests")
  receivedFriendRequests      FriendRequest[]   @relation("ReceivedRequests")
  messages                    Message[]         @relation("SentMessages")
  chats                       Chat[]            @relation("ChatParticipants")
  createdChats                Chat[]            @relation("ChatCreator")

  userId                      String            @unique
  user                        User              @relation(fields: [userId], references: [id])

  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime?
}

enum FriendRequestStatus {
  PENDING
  CANCELLED
  DECLINED
  ACCEPTED
}

model FriendRequest {
  id          String                @id @default(uuid())
  status      FriendRequestStatus   @default(PENDING)
  senderId    String
  sender      Profile               @relation("SentRequests", fields: [senderId], references: [id])
  receiverId  String
  receiver    Profile               @relation("ReceivedRequests", fields: [receiverId], references: [id])

  createdAt   DateTime              @default(now())
  updatedAt   DateTime?            
}

enum ChatType {
  DIRECT
  GROUP
}

model Chat {
  id                  String @id    @default(uuid())
  creatorId           String
  creator             Profile      @relation("ChatCreator", fields: [creatorId], references: [id])
  type                ChatType
  name                String?
  groupPictureUrl     String?
  messages            Message[]
  participants        Profile[]     @relation("ChatParticipants")

  createdAt           DateTime      @default(now())
  updatedAt           DateTime?
}

enum MessageType {
  TEXT
  IMAGE
}

model Message {
  id                String          @id @default(uuid())
  type              MessageType
  content           String?
  imageUrl          String?
  senderId          String
  sender            Profile         @relation("SentMessages", fields: [senderId], references: [id])
  chatId            String
  chat              Chat    @relation(fields: [chatId], references: [id])

  createdAt         DateTime        @default(now())
  updatedAt         DateTime?            
}

