{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },

  "references": [
    { "path": "./apps/backend" },
    { "path": "./apps/frontend" },

    { "path": "./packages/common" },
    { "path": "./packages/db" },
    { "path": "./packages/trpc" }
  ]
}
