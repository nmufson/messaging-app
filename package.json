{
  "name": "messaging-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm run build:packages",
    "build:packages": "pnpm --filter '@repo/common' build && pnpm --filter '@repo/db' build && pnpm --filter '@repo/backend' build",
    "build:clean": "pnpm --filter '@repo/common' clean && pnpm --filter '@repo/db' clean && pnpm --filter '@repo/backend' clean",
    "dev": "concurrently \"npm:dev-*\"",
    "dev-frontend": "npm --workspace=apps/frontend run dev",
    "dev-backend": "npm --workspace=apps/backend run dev",
    "dev-common": "npm --workspace=packages/common run dev",
    "dev-db": "npm --workspace=packages/db run dev",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "remeda": "^2.32.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.39.1",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.6",
    "@types/lodash": "^4.17.21",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20",
    "@types/qs": "^6.14.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "concurrently": "^9.0.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "prisma"
    ]
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
